# Copie este arquivo para .env no ambiente local ou cadastre estas variáveis no painel da hospedagem.
# Nunca envie o .env real para GitHub, cliente final ou ZIP público.

SECRET_KEY=troque_por_uma_chave_grande_e_aleatoria
FLASK_DEBUG=false
SMTP_DEBUG_RESPONSE=false
PORT=5000

COMPANY_NAME=TechWel
MAIL_SUBJECT_PREFIX=Nova solicitação pelo site Techwel
WHATSAPP_NUMBER=5532984560451

# SMTP Locaweb recomendado: email-ssl.com.br / 465 / SSL
# Para Hotmail/Outlook em teste no Railway/local: smtp.office365.com / 587 / TLS, MAIL_USE_SSL=false, MAIL_USE_TLS=true.
MAIL_SERVER=email-ssl.com.br
MAIL_PORT=587
MAIL_USE_SSL=true
MAIL_USE_TLS=true
MAIL_USERNAME=seu_email_locaweb@seudominio.com.br
MAIL_PASSWORD=sua_senha_do_email_locaweb
MAIL_DEFAULT_SENDER=seu_email_locaweb@seudominio.com.br

# Destinatários
MAIL_TO_EMAIL=joaolundin@hotmail.com
MAIL_BCC=joaoboscodev@hotmail.com
SEND_AUTO_REPLY=true

# Google reCAPTCHA v3. Para teste local/Railway inicial, deixe RECAPTCHA_ENABLED=false.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Proteções. Para bloqueio real de VPN/Proxy/país, informe PROXYCHECK_API_KEY ou use Cloudflare com cabeçalho CF-IPCountry.
BLOCK_NON_BR_IPS=true
BLOCK_PROXY_VPN=true
PROXYCHECK_API_KEY=

# Rate limit em memória. Para produção com múltiplas instâncias, use Redis/WAF.
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_REQUESTS=5
